[
  {
    "name": "top",
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin": "8 12 0 12",
    "modules-left": ["custom/userhost", "clock", "clock#cet"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["mpris", "hyprland/language", "custom/server", "custom/menu"],

    "mpris": {
      "format": "{player_icon} {title} - {artist}",
      "format-paused": "⏸ {title} - {artist}",
      "max-length": 40
    },
    "hyprland/language": {
      "format": "󰌌 {}",
      "format-en": "󰌌 en",
      "format-es": "󰌌 es"
    },
    "custom/server": {
      "exec": "~/.config/waybar/scripts/server.sh",
      "interval": 30,
      "tooltip": false
    },
    "custom/menu": {
      "format": "󰀻 MENU",
      "on-click": "hyprlauncher",
      "tooltip": false
    },
    "hyprland/workspaces": {
      "format": "{name}",
      "on-click": "activate"
    },
    "custom/userhost": {
      "exec": "echo \"$USER@$(hostname)\"",
      "interval": 3600,
      "format": "󰀄 {}"
    },
    "clock": {
      "format": "🕒 {:%H:%M:%S  %d/%m/%Y}",
      "tooltip-format": "Hora local"
    },
    "clock#cet": {
      "timezone": "Europe/Madrid",
      "format": "🌐 {:%H:%M  %d/%m} CET",
      "tooltip-format": "Hora CET (Madrid)"
    }
  },
  {
    "name": "bottom",
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "margin": "0 12 8 12",
    "modules-left": ["custom/wan", "custom/lan", "custom/tor", "custom/vpn"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["cpu", "custom/cputemp", "custom/gpuusage", "custom/gputemp", "memory", "custom/swap", "disk#root", "disk#home"],

    "cpu": {
      "format": "󰻠 CPU: {usage}%",
      "interval": 2
    },
    "custom/cputemp": {
      "exec": "~/.config/waybar/scripts/cpu-temp.sh",
      "interval": 5,
      "tooltip": false
    },
    "custom/gpuusage": {
      "exec": "~/.config/waybar/scripts/gpu-usage.sh",
      "interval": 3,
      "tooltip": false
    },
    "custom/gputemp": {
      "exec": "~/.config/waybar/scripts/gpu-temp.sh",
      "interval": 5,
      "tooltip": false
    },
    "memory": {
      "format": "󰍛 RAM: {percentage}%",
      "interval": 5
    },
    "custom/swap": {
      "exec": "~/.config/waybar/scripts/swap.sh",
      "interval": 10,
      "tooltip": false
    },
    "disk#root": {
      "format": "󰋊 /: {percentage_used}%",
      "path": "/",
      "interval": 60
    },
    "disk#home": {
      "format": "󰋊 ~: {percentage_used}%",
      "path": "/home",
      "interval": 60
    },
    "hyprland/window": {
      "max-length": 60,
      "separate-outputs": true
    },
    "custom/wan": {
      "exec": "~/.config/waybar/scripts/wan.sh",
      "interval": 10,
      "tooltip": false
    },
    "custom/lan": {
      "exec": "~/.config/waybar/scripts/lan.sh",
      "interval": 10,
      "tooltip": false
    },
    "custom/tor": {
      "exec": "~/.config/waybar/scripts/tor.sh",
      "interval": 15,
      "tooltip": false
    },
    "custom/vpn": {
      "exec": "~/.config/waybar/scripts/vpn.sh",
      "interval": 15,
      "tooltip": false
    }
  }
]
