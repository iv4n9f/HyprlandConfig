[
  {
    "name": "top",
    "layer": "top",
    "position": "top",
    "height": 26,
    "margin": "4 8 0 8",
    "modules-left": ["custom/userhost", "custom/hostname", "clock", "clock#cet"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["mpris", "pulseaudio", "hyprland/language", "custom/server", "custom/menu"],

    "mpris": {
      "format": "{player_icon} {title} - {artist}",
      "format-paused": "⏸ {title} - {artist}",
      "max-length": 35
    },
    "pulseaudio": {
      "format": "{icon}  {volume}%",
      "format-muted": "󰝟  muted",
      "format-icons": { "default": ["", "", ""] },
      "on-click": "pavucontrol"
    },
    "hyprland/language": {
      "format": "󰌌 {short}"
    },
    "custom/server": {
      "exec": "~/.config/waybar/scripts/server.sh",
      "return-type": "json",
      "interval": 30
    },
    "custom/menu": {
      "format": "󰀻 MENU",
      "on-click": "hyprlauncher",
      "tooltip-format": "Abrir menú de aplicaciones"
    },
    "hyprland/workspaces": {
      "format": "{name}",
      "on-click": "activate"
    },
    "custom/userhost": {
      "exec": "echo \"$USER@$(cat /etc/hostname)\"",
      "interval": 3600,
      "format": "󰀄 {}"
    },
    "custom/hostname": {
      "exec": "cat /etc/hostname",
      "interval": 3600,
      "format": "󰒋 {}"
    },
    "clock": {
      "format": "🕒 {:%H:%M:%S  %d/%m/%Y}",
      "tooltip-format": "Hora local del sistema"
    },
    "clock#cet": {
      "timezone": "Europe/Madrid",
      "format": "🌐 {:%H:%M  %d/%m} CET",
      "tooltip-format": "Hora CET (Madrid, España)"
    }
  },
  {
    "name": "bottom",
    "layer": "top",
    "position": "bottom",
    "height": 24,
    "margin": "0 8 4 8",
    "modules-left": ["custom/wan", "custom/lan", "custom/tor", "custom/vpn"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["cpu", "custom/cputemp", "custom/gpuusage", "custom/gputemp", "memory", "custom/swap", "disk#root", "disk#home"],

    "cpu": {
      "format": "󰻠 CPU: {usage}%",
      "interval": 2,
      "tooltip-format": "Uso de CPU\nCarga media: {{loadavg}}"
    },
    "custom/cputemp": {
      "exec": "~/.config/waybar/scripts/cpu-temp.sh",
      "return-type": "json",
      "interval": 5
    },
    "custom/gpuusage": {
      "exec": "~/.config/waybar/scripts/gpu-usage.sh",
      "return-type": "json",
      "interval": 3
    },
    "custom/gputemp": {
      "exec": "~/.config/waybar/scripts/gpu-temp.sh",
      "return-type": "json",
      "interval": 5
    },
    "memory": {
      "format": "󰍛 RAM: {percentage}%",
      "interval": 5,
      "tooltip-format": "RAM\n{used} / {total} GiB"
    },
    "custom/swap": {
      "exec": "~/.config/waybar/scripts/swap.sh",
      "return-type": "json",
      "interval": 10
    },
    "disk#root": {
      "format": "󰋊 /: {percentage_used}%",
      "path": "/",
      "interval": 60,
      "tooltip-format": "Disco raíz\n{used} / {total}"
    },
    "disk#home": {
      "format": "󰋊 ~: {percentage_used}%",
      "path": "/home",
      "interval": 60,
      "tooltip-format": "Disco home\n{used} / {total}"
    },
    "hyprland/window": {
      "max-length": 60,
      "separate-outputs": true,
      "tooltip-format": "Ventana activa"
    },
    "custom/wan": {
      "exec": "~/.config/waybar/scripts/wan.sh",
      "return-type": "json",
      "interval": 10
    },
    "custom/lan": {
      "exec": "~/.config/waybar/scripts/lan.sh",
      "return-type": "json",
      "interval": 10
    },
    "custom/tor": {
      "exec": "~/.config/waybar/scripts/tor.sh",
      "return-type": "json",
      "interval": 15
    },
    "custom/vpn": {
      "exec": "~/.config/waybar/scripts/vpn.sh",
      "return-type": "json",
      "interval": 15
    }
  }
]
