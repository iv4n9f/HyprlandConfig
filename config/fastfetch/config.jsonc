{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "padding": { "top": 1, "right": 2 },
    "color": { "1": "#00ff9f" }
  },
  "display": {
    "separator": "  ▸  ",
    "color": { "keys": "green", "title": "cyan" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "poweradapter",
    "separator",
    "colors"
  ]
}
